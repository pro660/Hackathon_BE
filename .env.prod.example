# =========================
# Runtime
# =========================
SPRING_PROFILES_ACTIVE=prod
PORT=8080
APP_PORT=8080

# =========================
# MySQL (Docker Compose)
# =========================
# backend -> mysql container uses service name "mysql"
MYSQLHOST=mysql
MYSQLPORT=3306
MYSQLDATABASE=hackathon
MYSQLUSER=hackathon
MYSQLPASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# =========================
# JWT / CORS
# =========================
JWT_ISSUER=hackathon-be
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGIN=https://your-frontend.vercel.app

# =========================
# OAuth frontend redirects
# =========================
FRONTEND_OAUTH_SUCCESS_URL=https://your-frontend.vercel.app/oauth/success
FRONTEND_OAUTH_ONBOARDING_URL=https://your-frontend.vercel.app/oauth/onboarding
FRONTEND_REAUTHENTICATION_SUCCESS_URL=https://your-frontend.vercel.app/account/reauthentication/success

# =========================
# Naver OAuth
# =========================
NAVER_CLIENT_ID=change-me
NAVER_CLIENT_SECRET=change-me
NAVER_REDIRECT_URI=https://api.example.com/api/auth/oauth/naver/callback

# =========================
# Kakao OAuth / Local
# =========================
KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me
KAKAO_REDIRECT_URI=https://api.example.com/api/auth/oauth/kakao/callback
KAKAO_LOCAL_REST_API_KEY=change-me

# =========================
# Cloudinary
# =========================
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# =========================
# OpenAI
# =========================
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-5.6-luna

# =========================
# One-time / schedulers
# =========================
# New production DB only: true on first boot, verify MCM products, then set false.
APP_PRODUCT_IMPORT_ENABLED=true
IMAGE_ASSET_CLEANUP_ENABLED=true
CARE_REMINDER_SCHEDULER_ENABLED=false
